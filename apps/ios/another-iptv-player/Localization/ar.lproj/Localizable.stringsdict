<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>common.days_format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d يوم</string>
			<key>one</key>
			<string>يوم واحد</string>
			<key>two</key>
			<string>يومان</string>
			<key>few</key>
			<string>%d أيام</string>
			<key>many</key>
			<string>%d يومًا</string>
			<key>other</key>
			<string>%d يوم</string>
		</dict>
	</dict>
	<key>detail.episode_count_plural</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d حلقة</string>
			<key>one</key>
			<string>حلقة واحدة</string>
			<key>two</key>
			<string>حلقتان</string>
			<key>few</key>
			<string>%d حلقات</string>
			<key>many</key>
			<string>%d حلقة</string>
			<key>other</key>
			<string>%d حلقة</string>
		</dict>
	</dict>
	<key>settings.stats.history_items_format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d عنصر</string>
			<key>one</key>
			<string>عنصر واحد</string>
			<key>two</key>
			<string>عنصران</string>
			<key>few</key>
			<string>%d عناصر</string>
			<key>many</key>
			<string>%d عنصرًا</string>
			<key>other</key>
			<string>%d عنصر</string>
		</dict>
	</dict>
	<key>search.more_results_format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>%d نتائج إضافية</string>
			<key>one</key>
			<string>نتيجة إضافية واحدة</string>
			<key>two</key>
			<string>نتيجتان إضافيتان</string>
			<key>few</key>
			<string>%d نتائج إضافية</string>
			<key>many</key>
			<string>%d نتيجة إضافية</string>
			<key>other</key>
			<string>%d نتيجة إضافية</string>
		</dict>
	</dict>
</dict>
</plist>
