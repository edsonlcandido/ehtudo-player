<?xml version="1.0" encoding="utf-8"?>
<!-- Solid black background that matches the icon's own dark canvas, so the
     adaptive icon's outer ring is invisible (foreground fills the inner
     66% safe zone, the outer 17% on each side shows this color). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#000000" />
</shape>
